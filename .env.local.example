# Create a free project at https://supabase.com, then Project Settings -> API
# to find these values. Copy this file to .env.local and fill them in.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never exposed to the browser. Used for admin tasks (e.g. inviting
# a family member by email) that must bypass row-level security.
SUPABASE_SERVICE_ROLE_KEY=
